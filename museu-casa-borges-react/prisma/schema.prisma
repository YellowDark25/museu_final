generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id            Int       @id @default(autoincrement())
  nome          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  passwordSalt  String    @map("password_salt")
  ativo         Boolean   @default(true)
  ultimoLoginEm DateTime? @map("ultimo_login_em") @db.Timestamptz(6)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("admin_users")
}

model Categoria {
  id              Int      @id @default(autoincrement())
  nome            String
  slug            String?  @unique
  tipo            String?
  descricao       String?
  ordem           Int      @default(0)
  ativa           Boolean  @default(true)
  exibirComoAba   Boolean  @default(true) @map("exibir_como_aba")
  layoutPublico   String   @default("lista") @map("layout_publico")
  criadoEm        DateTime? @default(now()) @map("criado_em") @db.Timestamp(6)
  midias          Midia[]

  @@map("categorias")
}

model Midia {
  id          Int       @id @default(autoincrement())
  categoriaId Int       @map("categoria_id")
  nome        String?
  url         String
  tipo        String?
  legenda     String?
  ordem       Int?      @default(0)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("midias")
}

model Exposicao {
  id         Int       @id @default(autoincrement())
  titulo     String
  descricao  String?
  tipo       String?
  dataInicio DateTime? @map("data_inicio") @db.Date
  dataFim    DateTime? @map("data_fim") @db.Date
  imagemCapa String?   @map("imagem_capa")

  @@map("exposicoes")
}

model Publicacao {
  id             Int       @id @default(autoincrement())
  titulo         String
  autor          String?
  descricao      String?
  urlArquivo     String?   @map("url_arquivo")
  ano            Int?
  /// Aba da biblioteca no site: publicacoes | pesquisas | artigos | tcc
  tipo           String?
  dataPublicacao DateTime? @map("data_publicacao") @db.Date
  topicos        String[]  @default([])
  visualizacoes  Int       @default(0)
  rating         Int       @default(5)
  ordem          Int       @default(0)

  @@map("publicacoes")
}

model GaleriaFoto {
  id       Int       @id @default(autoincrement())
  titulo   String?
  urlFoto  String    @map("url_foto")
  album    String?
  dataFoto DateTime? @map("data_foto") @db.Date
  ordem    Int?      @default(0)

  @@map("galeria_fotos")
}
