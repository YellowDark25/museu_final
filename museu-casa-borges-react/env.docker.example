# Exemplo para usar PostgreSQL via Docker Compose (docker-compose.yml na raiz).
# Copie as linhas necessárias para o seu arquivo .env na raiz do projeto.
#
# Importante: se o Postgres instalado na máquina já usa a porta 5432, pare o serviço local
# ou altere POSTGRES_PORT abaixo (ex.: 5433) e ajuste DATABASE_URL para localhost:5433

POSTGRES_USER=museu
POSTGRES_PASSWORD=museu_dev_change_me
POSTGRES_DB=museu_casa_borges
POSTGRES_PORT=5432

# Prisma / Next.js — aponte para o container (localhost na sua máquina)
DATABASE_URL="postgresql://museu:museu_dev_change_me@localhost:5432/museu_casa_borges?schema=public"
